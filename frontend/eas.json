{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CYNLABS_API_URL": "https://www.cynlabs.app/api",
        "EXPO_PUBLIC_CYNLABS_WEB_URL": "https://www.cynlabs.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CYNLABS_API_URL": "https://www.cynlabs.app/api",
        "EXPO_PUBLIC_CYNLABS_WEB_URL": "https://www.cynlabs.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CYNLABS_API_URL": "https://www.cynlabs.app/api",
        "EXPO_PUBLIC_CYNLABS_WEB_URL": "https://www.cynlabs.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
